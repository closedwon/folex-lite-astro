---
import Base from "@/layouts/Base.astro";
import { generatePaths } from "@/lib/utils/i18nUtils";
import { getEntryCTM } from "@/lib/contentParser.astro";
import IntroSection from "@/components/sections/IntroSection.astro";
import Clients from "@/components/sections/Clients.astro";
import HighlightCardsSection from "@/components/sections/HighlightCardsSection.astro";

export function getStaticPaths() {
  return generatePaths();
}

const page = await getEntryCTM("homepage", "-index", Astro.currentLocale);
---

<Base {...page?.data} headerPosition="sticky">
  <IntroSection />
  <Clients />
  <HighlightCardsSection />
</Base>
